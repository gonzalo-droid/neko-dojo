# URL pública del sitio. Se usa en metadatos, sitemap y vistas previas.
NEXT_PUBLIC_SITE_URL=https://nekodojo.app

# Servicio de formularios. Vacío = modo demostración (no se envía ni guarda nada).
# Ver src/lib/forms/provider.ts para conectar uno real.
FORMS_PROVIDER=
FORMS_WEBHOOK_URL=

# Panel /apps/animequote/admin (Firebase Realtime Database de AnimeQuote).
# Mismos valores que el proyecto quote-anime-web en Vercel. Sin ellos, el panel no conecta;
# el resto del sitio no los usa. Guía completa: docs/animequote-admin/README.md
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Correos de Google con acceso al panel, separados por comas (solo filtro de UI;
# la protección real son las reglas de Firebase).
NEXT_PUBLIC_ADMIN_ALLOWED_EMAILS=
